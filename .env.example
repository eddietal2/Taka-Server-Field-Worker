# Copy to .env (and optionally .env.local, which src/dev.ts loads first).
# Every value below is validated at boot by src/env.ts.

NODE_ENV=development
PORT=3000

# Neon Postgres: pooled URL for runtime, direct URL for migrations.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# 32+ characters. Sign the verification and access tokens.
JWT_SECRET=replace-with-at-least-32-characters-secret
VERIFICATION_TOKEN_TTL_SECONDS=900
ACCESS_TOKEN_TTL_SECONDS=2592000

# One-time passcodes.
OTP_SECRET=replace-with-at-least-16-characters
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RETENTION_SECONDS=86400
# Echoes the code back in the API response for local development. Must be false in production.
OTP_DEV_MODE=false
OTP_DEV_CODE=000000
OTP_MESSAGE_TEMPLATE=Taka: {{code}} is your verification code. It expires in {{minutes}} minutes.

# Delivery adapter: "log" writes the code to the server log; "africastalking" sends real SMS.
OTP_PROVIDER=log
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SMS_ENDPOINT=https://api.sandbox.africastalking.com/version1/messaging
AT_TIMEOUT_MS=10000

# Field-worker accounts are auto-approved unless this is false.
REGISTRATION_AUTO_APPROVE=true

# Cloudflare R2 for bounty proof photos and hub signature captures.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PRESIGN_TTL_SECONDS=300

# Bounty dispatch.
BOUNTY_CLAIM_TTL_SECONDS=2700
BOUNTY_PROOF_RADIUS_METERS=20
BOUNTY_RADAR_RADIUS_METERS=3000

# Hub weigh-in.
HUB_WEIGH_IN_MAX_KG=500

# Offline sync.
SYNC_MAX_BATCH_SIZE=200
SYNC_MIN_PING_MS=1200

# Optional: base URL of taka-server-resident, used to pull the resident directory
# that hub weigh-in resolves sellers against. Empty disables the sync job.
RESIDENT_DIRECTORY_SYNC_URL=

# Comma-separated origins for the Expo web build. Empty falls back to "*" (dev only).
CORS_ORIGINS=
